apiVersion: machine.openshift.io/v1beta1
kind: MachineSet
metadata:
  name: {{ ocp4_workload_tenant_gpu_machineset_name }}
  namespace: openshift-machine-api
  labels:
    machine.openshift.io/cluster-api-cluster: {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}
    tenant: {{ ocp4_workload_tenant_gpu_machineset_username }}
spec:
  replicas: {{ ocp4_workload_tenant_gpu_machineset_replicas }}
  selector:
    matchLabels:
      machine.openshift.io/cluster-api-cluster: {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}
      machine.openshift.io/cluster-api-machineset: {{ ocp4_workload_tenant_gpu_machineset_name }}
  template:
    metadata:
      labels:
        machine.openshift.io/cluster-api-cluster: {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}
        machine.openshift.io/cluster-api-machine-role: {{ ocp4_workload_tenant_gpu_machineset_role }}
        machine.openshift.io/cluster-api-machine-type: {{ ocp4_workload_tenant_gpu_machineset_role }}
        machine.openshift.io/cluster-api-machineset: {{ ocp4_workload_tenant_gpu_machineset_name }}
        tenant: {{ ocp4_workload_tenant_gpu_machineset_username }}
    spec:
      metadata:
        labels:
          node-role.kubernetes.io/{{ ocp4_workload_tenant_gpu_machineset_role }}: ""
          tenant: {{ ocp4_workload_tenant_gpu_machineset_username }}
      taints:
{% for taint in ocp4_workload_tenant_gpu_machineset_taints %}
        - key: {{ taint.key }}
          value: {{ taint.value }}
          effect: {{ taint.effect }}
{% endfor %}
      providerSpec:
        value:
          apiVersion: machine.openshift.io/v1beta1
          kind: AWSMachineProviderConfig
          ami:
            id: {{ _ocp4_workload_tenant_gpu_machineset_template.spec.template.spec.providerSpec.value.ami.id }}
          blockDevices:
            - ebs:
                volumeSize: {{ ocp4_workload_tenant_gpu_machineset_root_volume_size }}
                volumeType: {{ ocp4_workload_tenant_gpu_machineset_root_volume_type }}
          credentialsSecret:
            name: aws-cloud-credentials
          deviceIndex: 0
          iamInstanceProfile:
            id: {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}-worker-profile
          instanceType: {{ ocp4_workload_tenant_gpu_machineset_instance_type }}
          kind: AWSMachineProviderConfig
          metadata:
            creationTimestamp: null
          placement:
            availabilityZone: {{ _ocp4_workload_tenant_gpu_machineset_template.spec.template.spec.providerSpec.value.placement.availabilityZone }}
            region: {{ _ocp4_workload_tenant_gpu_machineset_region }}
          securityGroups:
            - filters:
                - name: tag:Name
                  values:
                    - {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}-worker-sg
          subnet:
            filters:
              - name: tag:Name
                values:
                  - {{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}-private-{{ _ocp4_workload_tenant_gpu_machineset_region }}{{ _ocp4_workload_tenant_gpu_machineset_template.spec.template.spec.providerSpec.value.placement.availabilityZone[-1:] }}
          tags:
            - name: kubernetes.io/cluster/{{ _ocp4_workload_tenant_gpu_machineset_infrastructure_name }}
              value: owned
            - name: tenant
              value: {{ ocp4_workload_tenant_gpu_machineset_username }}
          userDataSecret:
            name: worker-user-data
